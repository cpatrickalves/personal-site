---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getLocalePosts } from "@/utils/getLocalePosts";
import { toLocale } from "@/i18n/locales";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = toLocale(Astro.currentLocale);
const tags = getUniqueTags(await getLocalePosts(locale));

const t = useTranslations(locale);
---

<Layout
  title={`${t.pages.tagsTitle} | ${config.site.title}`}
  route={{ page: "tags" }}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <ul class="flex flex-wrap gap-6">
      {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} />)}
    </ul>
  </Main>

  <Footer />
</Layout>
