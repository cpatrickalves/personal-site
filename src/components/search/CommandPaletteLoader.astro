---
/**
 * The ⌘K palette's loader, adapted from karhdo.dev's
 * `CommandPaletteLoader.astro` (MIT, see THIRD_PARTY_NOTICES.md). In every
 * page through the Layout, and only plain script: no React until the first
 * open.
 *
 * Opens on ⌘K / Ctrl+K, on `/` outside text fields and on the
 * `open-command-palette` window event of the bar's search button. The first
 * open imports `mount-palette.tsx` (React and cmdk, a chunk of their own) and
 * mounts it in `#cmdk-root`, which `transition:persist` keeps across
 * ClientRouter navigations; later opens only send `cmdk:open` or
 * `cmdk:toggle`. `#cmdk-data` is rendered per page: the latest Posts, the
 * sections and the texts of the page's locale.
 */
import { getLocalePosts } from "@/utils/getLocalePosts";
import { formatDate, useTranslations } from "@/i18n";
import { toLocale } from "@/i18n/locales";
import { getPostUrl, localeUrl } from "@/i18n/urls";
import config from "@/config";
import {
  LATEST_POSTS,
  paletteSections,
  serialisePaletteData,
  type PaletteData,
} from "./palette-data";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { features, site } = config;

const posts = (await getLocalePosts(locale))
  .slice(0, LATEST_POSTS)
  .map(post => ({
    url: getPostUrl(post),
    title: post.data.title,
    date: formatDate(
      post.data.pubDatetime,
      post.data.timezone ?? site.timezone
    ),
  }));

const data: PaletteData = {
  posts,
  sections: paletteSections(
    { talks: features.talks, showArchives: features.showArchives },
    t.nav,
    route => localeUrl(locale, route)
  ),
  strings: t.search,
};
---

<div
  id="cmdk-root"
  transition:persist="command-palette"
  transition:name="command-palette"
  transition:animate="none"
>
</div>
<script
  type="application/json"
  id="cmdk-data"
  set:html={serialisePaletteData(data)}
/>

<script>
  import { paletteKey } from "./palette-data";

  const state: { mounted: boolean; loading?: Promise<void> } = {
    mounted: false,
  };

  /**
   * Dev only: the React plugin's refresh preamble is injected on pages with
   * an island, and the palette's TSX throws without it. Gone from builds.
   */
  async function installReactPreamble(): Promise<void> {
    if (!import.meta.env.DEV) return;
    const scope = window as unknown as Record<string, unknown>;
    if (scope.__vite_plugin_react_preamble_installed__) return;
    const refreshPath = "/@react-refresh";
    const refresh = await import(/* @vite-ignore */ refreshPath);
    refresh.default.injectIntoGlobalHook(window);
    scope.$RefreshReg$ = () => {};
    scope.$RefreshSig$ = () => (type: unknown) => type;
    scope.__vite_plugin_react_preamble_installed__ = true;
  }

  /** The first call loads and mounts the palette open; later ones tell it. */
  function openPalette(
    kind: "open" | "toggle",
    opener: HTMLElement | null = document.activeElement instanceof HTMLElement
      ? document.activeElement
      : null
  ): void {
    if (state.mounted) {
      window.dispatchEvent(
        new CustomEvent(`cmdk:${kind}`, { detail: { opener } })
      );
      return;
    }
    if (state.loading) return;
    const root = document.getElementById("cmdk-root");
    if (!root) return;
    state.loading = installReactPreamble()
      .then(() => import("./mount-palette"))
      .then(({ mountPalette }) => {
        mountPalette(root, opener);
        state.mounted = true;
      })
      // A failed chunk leaves the palette unmounted: the next try loads again.
      .catch(() => undefined)
      .finally(() => {
        state.loading = undefined;
      });
  }

  // Module scripts run once under the ClientRouter; the window flag guards
  // against a second copy of this script.
  const scope = window as Window & { __cmdkBound?: boolean };
  if (scope.__cmdkBound !== true) {
    scope.__cmdkBound = true;
    document.addEventListener("keydown", event => {
      const action = paletteKey(
        event,
        event.target instanceof HTMLElement ? event.target : null
      );
      if (!action) return;
      event.preventDefault();
      openPalette(action);
    });
    window.addEventListener("open-command-palette", event =>
      openPalette(
        "open",
        (event as CustomEvent<{ opener?: HTMLElement }>).detail?.opener ?? null
      )
    );
  }
</script>
