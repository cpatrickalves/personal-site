---
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import { toLocale } from "@/i18n/locales";
import { localePathUrl, localeUrl } from "@/i18n/urls";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

// Strip base prefix and trailing slash, then locale prefix so segments
// reflect the logical page path only.
const pathWithoutBase = stripBase(Astro.url.pathname).replace(/\/+$/, "");
const currentUrlPath = stripLocale(pathWithoutBase, locale);

// eg: /blog/tags/tailwindcss => ['blog', 'tags', 'tailwindcss']
const segments = currentUrlPath.split("/").slice(1).filter(Boolean);

const decodeSegment = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

const navLabels: Record<string, string> = {
  blog: t.nav.blog,
  tags: t.nav.tags,
  projects: t.nav.projects,
  talks: t.nav.talks,
  about: t.nav.about,
  archives: t.nav.archives,
  search: t.nav.search,
};

// A trailing page number joins the item before it:
// Home > Blog > 2 => Home > Blog (page 2)
const pageNumber =
  segments.length > 1 && /^\d+$/.test(segments.at(-1) ?? "")
    ? segments.pop()
    : undefined;

const breadcrumbList = segments.map((segment, index) => ({
  // Section names are capitalised; tag names keep their case.
  isSection: segment in navLabels,
  label: navLabels[segment] ?? decodeSegment(segment),
  href: localePathUrl(locale, `${segments.slice(0, index + 1).join("/")}/`),
}));

const lastItem = breadcrumbList.at(-1);
if (lastItem && pageNumber) {
  lastItem.label += ` (${t.pagination.page.toLowerCase()} ${pageNumber})`;
}
---

<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="flex flex-wrap items-center gap-x-1 font-light [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li class="flex items-center gap-x-1">
      <a href={localeUrl(locale, { page: "home" })} class="opacity-80">
        {t.nav.home}
      </a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      breadcrumbList.map(({ isSection, label, href }, index) =>
        index + 1 === breadcrumbList.length ? (
          <li>
            <span
              class:list={["opacity-75", { capitalize: isSection }]}
              aria-current="page"
            >
              {label}
            </span>
          </li>
        ) : (
          <li class="flex items-center gap-x-1">
            <a {href} class:list={["opacity-70", { capitalize: isSection }]}>
              {label}
            </a>
            <span aria-hidden="true" class="opacity-70">
              &raquo;
            </span>
          </li>
        )
      )
    }
  </ul>
</nav>
