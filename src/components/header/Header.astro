---
/**
 * The sticky top bar, adapted from karhdo.dev's `src/components/header/`
 * (MIT, see THIRD_PARTY_NOTICES.md) to the plate language: an opaque bar on
 * a 2px rule, the section links from md up and, below md, the full-screen
 * menu of `MobileNav`. Without JavaScript, below md, the links take a second
 * row of the bar instead, and the bar scrolls away. The bar is re-rendered on
 * every page, so its links and labels always follow the page's locale.
 */
import IconSearch from "@/assets/icons/IconSearch.svg";
import MobileNav from "./MobileNav.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { navItems } from "./navigation";
import { stripBase, stripLocale } from "@/utils/withBase";
import { LANG_TAGS, otherLocale, toLocale } from "@/i18n/locales";
import type { Route } from "@/i18n/routes";
import { getEquivalentUrl, localeUrl } from "@/i18n/urls";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  /** The page without its locale, the same the Layout gets for `hreflang`. */
  route: Route;
};

const { route } = Astro.props;
const { site, features } = config;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

// The switch speaks the language it leads to: its code, label and `lang`.
const target = otherLocale(locale);
const targetT = useTranslations(target);
const languageUrl = await getEquivalentUrl(route, target);

const homeUrl = localeUrl(locale, { page: "home" });
const searchUrl = localeUrl(locale, { page: "search" });
const pathname = Astro.url.pathname.replace(/\/?$/, "/");
const links = navItems(
  { talks: features.talks, showArchives: features.showArchives },
  stripLocale(stripBase(Astro.url.pathname), locale)
).map(({ key, route: itemRoute, current }) => ({
  href: localeUrl(locale, itemRoute),
  label: t.nav[key],
  current,
}));

const hasSearch = features.search !== false;
const hasThemeToggle = features.lightAndDarkMode;
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent-ink absolute inset-s-16 -top-full z-50 px-3 py-2 transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="site-header bg-background border-border sticky top-0 z-40 border-b-2"
  transition:name="site-header"
  transition:animate="none"
>
  <div class="site-bar app-layout flex min-h-16 items-center gap-3">
    <a
      href={homeUrl}
      class="me-auto py-2 text-lg font-semibold tracking-[-0.02em] whitespace-nowrap"
    >
      {site.title}
    </a>

    <nav aria-label={t.a11y.mainNav} class="site-nav hidden md:block">
      <ul class="flex items-center">
        {
          links.map(({ href, label, current }) => (
            <li>
              <a href={href} class="nav-link" aria-current={current}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      /* The tools, one strip of 40px squares: search, theme, then the
        language switch; #20 turns search into the ⌘K palette. Below md
        the strip ends with the menu button. */
    }
    <div class="border-outline flex border-2 [&>*+*]:border-s-2">
      {
        hasSearch && (
          <a
            href={searchUrl}
            class="tool-btn"
            aria-current={pathname === searchUrl ? "page" : undefined}
            title={t.nav.search}
          >
            <IconSearch aria-hidden="true" />
            <span class="sr-only">{t.nav.search}</span>
          </a>
        )
      }
      {hasThemeToggle && <ThemeToggle />}
      <a
        href={languageUrl}
        class="tool-btn lang-btn"
        hreflang={LANG_TAGS[target]}
        lang={LANG_TAGS[target]}
        title={targetT.a11y.switchLanguage}
      >
        {targetT.nav.languageCode}
        <span class="sr-only">{` ${targetT.a11y.switchLanguage}`}</span>
      </a>
      <MobileNav links={links} homeUrl={homeUrl} title={site.title} />
    </div>
  </div>
</header>

<style is:global>
  @reference "@/styles/global.css";

  @layer components {
    /* A square tool of the bar: 40px, filled with the card on hover. */
    .tool-btn {
      @apply inline-flex size-10 items-center justify-center;
      color: var(--foreground);
      transition: background-color 0.2s;

      &:hover {
        background-color: var(--card);
      }

      &[aria-current] {
        background-color: var(--foreground);
        color: var(--background);
      }

      svg {
        @apply size-5 shrink-0;
      }
    }
  }
</style>

<style>
  @reference "@/styles/global.css";

  .lang-btn {
    @apply text-[0.9375rem] font-semibold tracking-[0.04em];
  }

  /*
   * Without JavaScript the menu can't open: below md the links take a row. The
   * bar is then too tall to stay fixed: it would cover the screen and anchors.
   */
  @media (scripting: none) and (width < 48rem) {
    .site-header {
      position: static;
    }

    .site-bar {
      flex-wrap: wrap;
      padding-block: 0.75rem 0.25rem;
    }

    .site-nav {
      display: block;
      order: 1;
      flex-basis: 100%;
      margin-inline-start: -0.625rem;
    }

    .site-nav ul {
      flex-wrap: wrap;
    }
  }

  .nav-link {
    @apply inline-flex min-h-10 items-center px-2.5 text-[0.9375rem] font-medium;
    color: var(--muted-foreground);
    transition: color 0.2s;

    &:hover,
    &[aria-current] {
      color: var(--foreground);
    }

    &[aria-current] {
      @apply active-nav;
      text-decoration-color: var(--accent-ink);
    }
  }
</style>

<script>
  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
